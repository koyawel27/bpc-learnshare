APP_NAME="BPC LearnShare"
APP_ENV=local
APP_DEBUG=false
APP_TIMEZONE=Asia/Manila
APP_URL=http://localhost:8081

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bpc_learnshare_dev
DB_USER=bpc_learnshare_app
DB_PASS=replace-with-local-password

# Local AI processing remains off unless both this switch and the live
# system_settings.ai_enabled value are explicitly enabled.
AI_LOCAL_PROCESSING_ENABLED=false
OLLAMA_API_BASE=http://127.0.0.1:11434
OLLAMA_EXPECTED_VERSION=0.32.1
OLLAMA_EMBEDDING_MODEL=all-minilm:latest
OLLAMA_EMBEDDING_MODEL_DIGEST=1b226e2802dbb772b5fc32a58f103ca1804ef7501331012de126ab22f67475ef
OLLAMA_EMBEDDING_DIMENSION=384
